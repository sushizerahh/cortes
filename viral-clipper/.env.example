# ─── Required ─────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ─── Whisper model ────────────────────────────────────────────────────────────
# Options: tiny, base, small, medium, large-v2, large-v3
# Larger = better accuracy, slower, more VRAM
# Recommended for Portuguese: medium or large-v3
WHISPER_MODEL=medium

# ─── Clip defaults ────────────────────────────────────────────────────────────
CLIP_MIN_DURATION=15
CLIP_MAX_DURATION=59
MAX_CLIPS_PER_VIDEO=10

# ─── Subtitle style ───────────────────────────────────────────────────────────
# Options: default, neon, minimal, bold
DEFAULT_SUBTITLE_STYLE=default

# ─── Claude model ─────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-opus-4-6

# ─── API server ───────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000

# ─── Watermark / Logo ─────────────────────────────────────────────────────────
# Path to your logo PNG file (use transparent background for best result)
# Example (Windows): WATERMARK_PATH=C:\Users\magas\Desktop\logo.png
# Example (relative): WATERMARK_PATH=data/logo.png
WATERMARK_PATH=

# Position: top-left | top-center | top-right | bottom-left | bottom-center | bottom-right
WATERMARK_POSITION=top-center

# Logo width in pixels (height scales automatically)
WATERMARK_WIDTH=220

# Opacity: 1.0 = fully visible, 0.5 = semi-transparent
WATERMARK_OPACITY=1.0

# Distance from the edge in pixels
WATERMARK_MARGIN=30

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
